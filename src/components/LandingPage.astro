---
const GITHUB = '#a684ff'
const AI = '#a78bfa'
const HUMAN = '#60a5fa'
const AGENT = '#34d399'
---

<!-- Nav -->
<nav class="fixed top-0 inset-x-0 z-50 flex h-16 items-center justify-between border-b border-white/10 bg-background/70 px-6 backdrop-blur-md sm:px-10">
  <a
    href="/"
    class="rounded-full border border-white/10 px-3 py-1.5 font-mono text-sm font-medium tracking-tight transition-colors hover:bg-white/5"
  >
    drains.dev
  </a>
  <div class="hidden items-center gap-8 sm:flex">
    <a href="/#features" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Features</a>
    <a href="/#agents" class="text-sm text-muted-foreground hover:text-foreground transition-colors">For agents</a>
    <a href="/#how" class="text-sm text-muted-foreground hover:text-foreground transition-colors">How it works</a>
    <a href="/docs" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Docs</a>
  </div>
  <div class="flex items-center gap-4">
    <a href="/login" class="hidden text-sm text-muted-foreground hover:text-foreground transition-colors sm:inline">
      Log in
    </a>
    <a
      href="/signup"
      class="rounded-full bg-foreground px-4 py-1.5 text-sm font-medium text-background transition-opacity hover:opacity-85"
    >
      Sign up free
    </a>
  </div>
</nav>

<!-- Hero -->
<section class="relative overflow-hidden px-6 pt-44 pb-28 text-center sm:pt-52">
  <!-- ambient glow -->
  <div
    class="pointer-events-none absolute left-1/2 top-16 -z-10 h-[520px] w-[900px] -translate-x-1/2 opacity-40"
    style="background: radial-gradient(closest-side, oklch(0.35 0.12 300 / 0.5), transparent 70%);"
  ></div>

  <a
    href="/signup"
    class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs text-muted-foreground transition-colors hover:bg-white/10"
  >
    <span class="h-1.5 w-1.5 rounded-full bg-violet-400"></span>
    Early access — free while we're in testing, pricing not decided yet
  </a>

  <p class="mb-7 font-mono text-xs tracking-[0.2em] text-muted-foreground">MULTIPLE SOURCES. ONE LOG.</p>

  <h1 class="mx-auto max-w-4xl text-6xl font-medium leading-[0.98] tracking-[-0.03em] sm:text-7xl">
    Every source drains<br />into one log.
  </h1>

  <p class="mx-auto mt-7 max-w-lg text-lg leading-relaxed text-muted-foreground">
    Commits, incidents, decisions, and AI summaries — everything that happens
    on a project, in one running log. Offline-first, synced everywhere.
  </p>

  <div class="mt-10 flex items-center justify-center gap-3">
    <a
      href="/signup"
      class="rounded-full bg-foreground px-6 py-3 text-sm font-medium text-background transition-opacity hover:opacity-85"
    >
      Start logging
    </a>
    <a
      href="/#how"
      class="rounded-full border border-white/15 px-6 py-3 text-sm font-medium transition-colors hover:bg-white/5"
    >
      See how it works
    </a>
  </div>

  <!-- Signature: sources converging into the product window -->
  <div class="relative mx-auto mt-24 w-full max-w-4xl">
    <svg viewBox="0 0 1000 90" class="mx-auto block w-full max-w-3xl" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
      <path class="flow-path" d="M120,10 C120,60 480,60 496,88" fill="none" stroke={GITHUB} stroke-width="1.5" opacity="0.7" />
      <path class="flow-path" d="M373,10 C373,55 480,55 498,88" fill="none" stroke={AI} stroke-width="1.5" opacity="0.7" style="animation-delay: -0.7s" />
      <path class="flow-path" d="M627,10 C627,55 520,55 502,88" fill="none" stroke={HUMAN} stroke-width="1.5" opacity="0.7" style="animation-delay: -1.4s" />
      <path class="flow-path" d="M880,10 C880,60 520,60 504,88" fill="none" stroke={AGENT} stroke-width="1.5" opacity="0.7" style="animation-delay: -2.1s" />
      <g font-family="var(--font-mono)" text-anchor="middle">
        <circle cx="120" cy="10" r="9" fill={GITHUB} />
        <text x="120" y="13" font-size="8" font-weight="600" fill="white">PR</text>
        <text x="120" y="34" font-size="13" font-weight="500" fill="var(--foreground)">Pull requests</text>

        <circle cx="373" cy="10" r="9" fill={AI} />
        <text x="373" y="13" font-size="8" font-weight="600" fill="white">AI</text>
        <text x="373" y="34" font-size="13" font-weight="500" fill="var(--foreground)">AI</text>

        <circle cx="627" cy="10" r="9" fill={HUMAN} />
        <text x="627" y="13" font-size="8" font-weight="600" fill="white">Y</text>
        <text x="627" y="34" font-size="13" font-weight="500" fill="var(--foreground)">You</text>

        <circle cx="880" cy="10" r="9" fill={AGENT} />
        <text x="880" y="13" font-size="8" font-weight="600" fill="white">T</text>
        <text x="880" y="34" font-size="13" font-weight="500" fill="var(--foreground)">Team</text>
      </g>
    </svg>

    <div class="relative rounded-2xl border border-white/10 bg-card text-left shadow-[0_0_120px_-20px_oklch(0.5_0.15_300/0.35)]">
      <div class="flex items-center gap-2 border-b border-white/10 px-5 py-3.5">
        <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
        <span class="ml-2 font-mono text-xs text-muted-foreground">api-service</span>
      </div>
      <div class="flex min-h-[420px] flex-col sm:flex-row">
        <div class="hidden w-52 shrink-0 space-y-2 border-r border-white/10 p-4 sm:block">
          <div class="rounded-lg border border-ring bg-secondary/60 p-2.5">
            <p class="text-xs font-medium">API service</p>
            <p class="mt-0.5 text-[10px] text-muted-foreground">Private</p>
          </div>
          <div class="rounded-lg border border-transparent p-2.5 opacity-60">
            <p class="text-xs font-medium">Checkout redesign</p>
            <p class="mt-0.5 text-[10px] text-muted-foreground">Shared</p>
          </div>
          <div class="rounded-lg border border-transparent p-2.5 opacity-40">
            <p class="text-xs font-medium">Payments</p>
            <p class="mt-0.5 text-[10px] text-muted-foreground">Private</p>
          </div>
        </div>
        <div class="flex-1 space-y-2.5 p-5 pb-16">
          <div class="rounded-lg border border-white/10 p-3" style={`background: color-mix(in srgb, ${GITHUB} 14%, var(--card));`}>
            <p class="text-sm">
              <span class="mr-1.5 inline-flex items-center gap-1 rounded-full bg-white/10 px-1.5 py-0.5 align-middle text-[10px] font-medium text-muted-foreground">
                <svg class="size-2.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.4 9.4 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .26.18.58.69.48A10 10 0 0 0 12 2z"/></svg>
                GitHub
              </span>
              merged fix/auth-refresh-race (#482)
            </p>
          </div>
          <div class="rounded-lg border border-white/10 p-3" style={`background: color-mix(in srgb, ${HUMAN} 12%, var(--card));`}>
            <p class="text-sm">
              Paged in <span class="rounded px-1 font-medium" style={`background: color-mix(in srgb, ${HUMAN} 22%, transparent); color: ${HUMAN};`}>@dana</span>
              — redis latency spike, mitigated by scaling the read replica.
            </p>
          </div>
          <div class="relative mt-6 rounded-lg border border-white/10 p-3" style={`background: linear-gradient(to right, color-mix(in srgb, ${AI} 16%, var(--card)), var(--card));`}>
            <span class="absolute -top-5 left-2 flex items-center gap-1 rounded-full bg-violet-500/15 px-1.5 py-0.5 text-[10px] font-medium text-violet-300">
              <svg class="size-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/></svg>
              AI Summary
            </span>
            <p class="text-sm text-muted-foreground">
              Shipped the auth fix, resolved the redis incident, kept the read-replica scaling policy from today's page.
            </p>
          </div>
          <div class="rounded-lg border border-dashed border-white/10 p-3 text-sm text-muted-foreground/70">
            Click to start typing…
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Features -->
<section id="features" class="px-6 py-28 sm:py-36">
  <div class="mx-auto max-w-5xl">
    <p class="mb-4 font-mono text-xs tracking-[0.2em] text-muted-foreground">FEATURES</p>
    <h2 class="max-w-lg text-4xl font-medium tracking-[-0.02em] sm:text-5xl">Nothing to configure.<br />Nothing to lose.</h2>

    <div class="mt-16 grid gap-5 lg:grid-cols-2">
      <!-- AI summaries -->
      <div class="rounded-2xl border border-white/10 bg-card p-8">
        <div class="mb-8 flex items-center justify-center rounded-xl border border-white/10 bg-background/60 p-6">
          <div class="w-full max-w-xs space-y-2">
            <div class="h-2 w-full rounded-full bg-white/10"></div>
            <div class="h-2 w-4/5 rounded-full bg-white/10"></div>
            <div class="h-2 w-full rounded-full bg-white/10"></div>
            <div class="my-3 flex justify-center">
              <svg class="size-4 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
            </div>
            <div class="rounded-lg border border-white/10 p-2.5" style={`background: color-mix(in srgb, ${AI} 14%, var(--card));`}>
              <span class="mb-1.5 inline-flex items-center gap-1 rounded-full bg-violet-500/15 px-1.5 py-0.5 text-[9px] font-medium text-violet-300">AI Summary</span>
              <div class="h-1.5 w-full rounded-full bg-white/10"></div>
            </div>
          </div>
        </div>
        <h3 class="mb-1.5 text-lg font-medium">AI that edits, not replaces</h3>
        <p class="text-sm leading-relaxed text-muted-foreground">Summarize a busy day into one entry, or refine grammar and tone without losing your own words.</p>
      </div>

      <!-- Mentions / references -->
      <div class="rounded-2xl border border-white/10 bg-card p-8">
        <div class="mb-8 flex items-center justify-center rounded-xl border border-white/10 bg-background/60 p-6">
          <p class="max-w-xs text-sm leading-loose">
            Paged in
            <span class="rounded px-1 font-medium" style={`background: color-mix(in srgb, ${HUMAN} 22%, transparent); color: ${HUMAN};`}>@dana</span>
            — see
            <span class="inline-flex items-center rounded px-1.5 font-medium" style="background: oklch(0.45 0.12 280 / 0.2); color: oklch(0.75 0.1 280);">[[ incidents ]]</span>
            for context.
          </p>
        </div>
        <h3 class="mb-1.5 text-lg font-medium">Mentions and references, inline</h3>
        <p class="text-sm leading-relaxed text-muted-foreground">@mention a teammate, [[ link another drain or entry, or leave a comment anchored to the text.</p>
      </div>

      <!-- Offline & sync -->
      <div class="rounded-2xl border border-white/10 bg-card p-8">
        <div class="mb-8 flex items-center justify-center gap-4 rounded-xl border border-white/10 bg-background/60 p-6">
          <span class="flex items-center gap-1.5 rounded-full border border-white/10 px-3 py-1.5 text-xs text-muted-foreground">
            <span class="h-2 w-2 rounded-full bg-emerald-400"></span> synced
          </span>
          <span class="flex items-center gap-1.5 rounded-full border border-white/10 px-3 py-1.5 text-xs text-muted-foreground">
            <span class="h-2 w-2 rounded-full bg-neutral-500"></span> offline — 3 pending
          </span>
        </div>
        <h3 class="mb-1.5 text-lg font-medium">Offline-first, synced everywhere</h3>
        <p class="text-sm leading-relaxed text-muted-foreground">Keep writing with no connection. Every device sees every entry the moment you're back online.</p>
      </div>

      <!-- Privacy -->
      <div class="rounded-2xl border border-white/10 bg-card p-8">
        <div class="mb-8 flex items-center justify-center rounded-xl border border-white/10 bg-background/60 p-6">
          <div class="flex items-center gap-2 rounded-lg border border-white/10 px-4 py-3 text-xs text-muted-foreground">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Members only
          </div>
        </div>
        <h3 class="mb-1.5 text-lg font-medium">Private by default</h3>
        <p class="text-sm leading-relaxed text-muted-foreground">Each drain is its own database with its own membership rules — only the people you invite can read or write it, enforced by the database, not just the app.</p>
      </div>
    </div>
  </div>
</section>

<!-- Agent-native -->
<section id="agents" class="border-y border-white/10 bg-card/40 px-6 py-28 sm:py-36">
  <div class="mx-auto grid max-w-5xl gap-14 md:grid-cols-2 md:items-center">
    <div>
      <p class="mb-4 font-mono text-xs tracking-[0.2em] text-muted-foreground">FOR AGENTS</p>
      <h2 class="mb-5 text-4xl font-medium tracking-[-0.02em] sm:text-5xl">A knowledge base your agents actually have.</h2>
      <p class="mb-7 text-base leading-relaxed text-muted-foreground">
        Connect Claude Code, or any MCP-compatible agent, directly to a drain.
        It queries the log for context before it starts — why a decision was made,
        what broke last time — and writes its own entries as it works, attributed
        and in the same timeline as everything a person typed. One
        durable memory, shared by every agent you run.
      </p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <a href="/signup" class="inline-flex items-center gap-1.5 text-sm font-medium hover:opacity-70 transition-opacity">
          Generate an API token
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/AGENTS.md" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors">
          Read AGENTS.md
        </a>
      </div>
    </div>

    <div class="rounded-2xl border border-white/10 bg-card overflow-hidden">
      <div class="flex items-center gap-2 border-b border-white/10 px-5 py-3.5">
        <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
        <span class="ml-2 font-mono text-xs text-muted-foreground">claude_desktop_config.json</span>
      </div>
      <pre class="overflow-x-auto p-5 font-mono text-[13px] leading-relaxed"><code><span class="text-muted-foreground">{`{`}</span>
  <span style={`color:${AI}`}>"mcpServers"</span>: {`{`}
    <span style={`color:${AI}`}>"drains"</span>: {`{`}
      <span style={`color:${HUMAN}`}>"command"</span>: <span class="text-muted-foreground">"npx"</span>,
      <span style={`color:${HUMAN}`}>"args"</span>: [<span class="text-muted-foreground">"-y"</span>, <span class="text-muted-foreground">"github:drains-dev/mcp"</span>]
    {`}`}
  {`}`}
{`}`}</code></pre>
      <div class="space-y-2.5 border-t border-white/10 px-5 py-4">
        <p class="text-xs">
          <span class="mr-1.5 rounded-full px-1.5 py-0.5 text-[10px] font-medium" style={`background: color-mix(in srgb, ${HUMAN} 20%, transparent); color: ${HUMAN};`}>queried</span>
          <span class="text-muted-foreground">why was dynamo replaced with postgres for orders?</span>
        </p>
        <p class="text-xs">
          <span class="mr-1.5 rounded-full px-1.5 py-0.5 text-[10px] font-medium" style={`background: color-mix(in srgb, ${AGENT} 20%, transparent); color: ${AGENT};`}>via mcp</span>
          <span class="text-muted-foreground">bumped retry backoff on the sync client, logged why</span>
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Use cases -->
<section class="px-6 py-28 sm:py-36">
  <div class="mx-auto max-w-5xl">
    <p class="mb-4 font-mono text-xs tracking-[0.2em] text-muted-foreground">USE CASES</p>
    <h2 class="mb-16 text-4xl font-medium tracking-[-0.02em] sm:text-5xl">However you ship.</h2>

    <div class="grid gap-5 sm:grid-cols-2">
      <!-- Solo builder -->
      <div class="rounded-2xl border border-white/10 bg-card p-8">
        <div class="mb-6 flex items-center justify-center rounded-xl border border-white/10 bg-background/60 p-6">
          <div class="w-full max-w-[140px] rounded-lg border border-ring bg-secondary/60 p-2.5">
            <div class="flex items-center gap-1.5">
              <svg class="size-3 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <span class="text-[11px] font-medium">Side project</span>
            </div>
            <p class="mt-1 text-[9px] text-muted-foreground">Just me</p>
          </div>
        </div>
        <h3 class="mb-1.5 font-medium">Solo builder</h3>
        <p class="text-sm leading-relaxed text-muted-foreground">A personal engineering journal — why you built it that way, searchable months later.</p>
      </div>

      <!-- On-call & SRE -->
      <div class="rounded-2xl border border-white/10 bg-card p-8">
        <div class="mb-6 flex items-center justify-center rounded-xl border border-white/10 bg-background/60 p-6">
          <div class="flex flex-col items-start gap-2 text-[10px] text-muted-foreground">
            <span class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-rose-400"></span>paged 02:14</span>
            <span class="ml-1 h-3 w-px bg-white/15"></span>
            <span class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-amber-400"></span>mitigated 02:26</span>
            <span class="ml-1 h-3 w-px bg-white/15"></span>
            <span class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-emerald-400"></span>resolved 03:02</span>
          </div>
        </div>
        <h3 class="mb-1.5 font-medium">On-call &amp; SRE</h3>
        <p class="text-sm leading-relaxed text-muted-foreground">Deploys, pages, and mitigations on one timeline — a clean handoff at the end of a shift.</p>
      </div>

      <!-- Small teams -->
      <div class="rounded-2xl border border-white/10 bg-card p-8">
        <div class="mb-6 flex items-center justify-center rounded-xl border border-white/10 bg-background/60 p-6">
          <div class="flex items-center gap-2">
            <span class="flex -space-x-2">
              <span class="flex size-6 items-center justify-center rounded-full border-2 border-card text-[9px] font-medium text-white" style={`background:${HUMAN}`}>D</span>
              <span class="flex size-6 items-center justify-center rounded-full border-2 border-card text-[9px] font-medium text-white" style={`background:${GITHUB}`}>R</span>
              <span class="flex size-6 items-center justify-center rounded-full border-2 border-card text-[9px] font-medium text-white" style={`background:${AGENT}`}>M</span>
            </span>
            <span class="rounded-full border border-white/10 px-2 py-0.5 text-[10px] text-muted-foreground">Shared</span>
          </div>
        </div>
        <h3 class="mb-1.5 font-medium">Small teams</h3>
        <p class="text-sm leading-relaxed text-muted-foreground">One drain per project — replaces the scattered Slack thread nobody can find later.</p>
      </div>

      <!-- Build in public -->
      <div class="rounded-2xl border border-white/10 bg-card p-8">
        <div class="mb-6 flex items-center justify-center rounded-xl border border-white/10 bg-background/60 p-6">
          <div class="flex items-center gap-1.5 rounded-full border border-white/10 bg-card px-3 py-1.5 font-mono text-[10px] text-muted-foreground">
            drains.dev/p/8fq2m
            <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6M10 14 21 3"/></svg>
          </div>
        </div>
        <h3 class="mb-1.5 font-medium">Build in public</h3>
        <p class="text-sm leading-relaxed text-muted-foreground">Publish a read-only share link — a running changelog people can actually follow.</p>
      </div>
    </div>
  </div>
</section>

<!-- How it works -->
<section id="how" class="border-y border-white/10 bg-card/40 px-6 py-28 sm:py-36">
  <div class="mx-auto grid max-w-5xl gap-14 lg:grid-cols-2 lg:items-center">
    <div>
      <p class="mb-4 font-mono text-xs tracking-[0.2em] text-muted-foreground">HOW IT WORKS</p>
      <h2 class="mb-10 text-4xl font-medium tracking-[-0.02em] sm:text-5xl">Three steps to a better log.</h2>

      <div class="space-y-8">
        <div class="flex gap-5">
          <span class="mt-0.5 shrink-0 font-mono text-sm text-muted-foreground">01</span>
          <div>
            <h3 class="mb-1 font-medium">Create an identity</h3>
            <p class="text-sm leading-relaxed text-muted-foreground">Your name and email. It becomes a deterministic color and ID that follows you everywhere.</p>
          </div>
        </div>
        <div class="flex gap-5">
          <span class="mt-0.5 shrink-0 font-mono text-sm text-muted-foreground">02</span>
          <div>
            <h3 class="mb-1 font-medium">Open a drain</h3>

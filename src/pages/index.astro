---
import PageShell from "@/components/PageShell";
import HomeStart from "@/components/HomeStart";
import Layout from "../layouts/Layout.astro";
import LandingLayout from "@/components/LandingLayout.astro";
import LandingPage from "@/components/LandingPage.astro";

const cookie = Astro.cookies.get('sk_identity');
const identity = cookie ? cookie.json() : null;
---

{identity ? (
	<Layout noindex>
		<PageShell client:load>
			<HomeStart client:load />
		</PageShell>
	</Layout>
) : (
	<LandingLayout>
		<LandingPage />
	</LandingLayout>
)}

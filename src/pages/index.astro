---
import AppShell from "@/components/AppShell.astro";
import HomeStart from "@/components/HomeStart";
import Layout from "../layouts/Layout.astro";
import LandingLayout from "@/components/LandingLayout.astro";
import LandingPage from "@/components/LandingPage.astro";

const cookie = Astro.cookies.get('sk_identity');
const identity = cookie ? cookie.json() : null;
---

{identity ? (
	<Layout noindex>
		<AppShell>
			<HomeStart client:load />
		</AppShell>
	</Layout>
) : (
	<LandingLayout>
		<LandingPage />
	</LandingLayout>
)}
